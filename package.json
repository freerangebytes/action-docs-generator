{
  "name": "action-docs-generator",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/freerangebytes/action-docs-generator"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "Docs"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "ncc build dist/index.js -o action"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/format": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "handlebars": "^4.7.9",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "flatted": ">= 3.4.2"
  }
}

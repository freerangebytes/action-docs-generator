{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-checking config: covers everything the build config leaves out —
  // test files and the root-level tooling configs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "action"]
}
